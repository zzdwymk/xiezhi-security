{
  "name": "security-toolbox-desktop",
  "private": true,
  "version": "0.2.0",
  "description": "Xiezhi authorized security testing platform",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "test:json-file": "node scripts/test-json-file.cjs",
    "test:offline": "node scripts/verify-offline-tools.cjs",
    "test:visual": "node scripts/visual-smoke.cjs",
    "preview": "vite preview",
    "desktop:dev": "node electron/dev-runner.cjs",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:build": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@fluentui/svg-icons": "^1.1.334",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "adm-zip": "^0.6.0",
    "axios": "^1.7.9",
    "dompurify": "^3.4.12",
    "echarts": "^6.1.0",
    "element-plus": "^2.9.1",
    "marked": "^18.0.7",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.54.2",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.23",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "build": {
    "appId": "com.bachelor.securitytoolbox",
    "productName": "獬豸",
    "asar": true,
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../security-toolbox-server/target/security-toolbox-server-0.1.0.jar",
        "to": "server/security-toolbox-server.jar"
      },
      {
        "from": "../ai-runtime/dist/security-toolbox-ai-runtime",
        "to": "ai-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "desktop-release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "xiezhi-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
