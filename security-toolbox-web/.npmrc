# Mirrors are consumed by Electron / electron-builder install scripts via their own
# environment variables, NOT as npm config. npm 11 warns about unknown project config
# keys ("electron_mirror" etc.), so keep the mirrors as env vars instead.
# electron:      ELECTRON_MIRROR
# electron-builder: ELECTRON_BUILDER_BINARIES_MIRROR
# Set them in the shell / CI (or the scripts/setup-deps-and-sync.cjs helper) before install:
#   set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/
#   set ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/
