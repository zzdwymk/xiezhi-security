# ============================================================
# 毕业论文相关材料：一律不进入公开仓库。
# 包括开题报告、任务书、论文正文、查重稿、参考文献、答辩材料与各类表单，
# 以及为论文生成这些材料的脚本（见下方 scripts/ 段落）。
# 这些材料仅保留在本地 docs/ 与第三方模板中。
# ============================================================
docs/

# 论文与文档类扩展名（含 WPS / OpenDocument / LaTeX / iWork / RTF 等，
# 防止论文换一种格式保存后意外被提交）。
*.md
!/README.md
*.doc
*.docx
*.pdf
*.ppt
*.pptx
*.xls
*.xlsx
*.odt
*.odp
*.ods
*.rtf
*.wps
*.pages
*.numbers
*.tex
*.bib
*.epub

# Office / WPS 打开文档时产生的临时锁文件。
~$*

# scripts/ 采用白名单：只有下列启动、发布与代码统计脚本属于公开仓库范围。
# 该白名单与 .github/workflows/ci.yml 中 hygiene 任务的检查保持一致，
# 避免本地脚本被提交后直接导致 CI 失败。
scripts/*
!scripts/package-desktop-release.ps1
!scripts/start-all.ps1
!scripts/start-desktop.ps1
!scripts/status-all.ps1
!scripts/stop-all.ps1
!scripts/count_code.py
!scripts/code_line_metrics.py
!scripts/requirements-code-count.txt
!scripts/test_count_code.py
!scripts/test_code_line_metrics.py

# 本地 QA、审计、复现与压测脚本（scripts/qa/ 下两百余个文件），仅供本地运行。
# 正式测试位于 security-toolbox-web/tests/、ai-runtime/tests/ 及各模块 src/test/。
scripts/qa/

# 论文、开题与各类表单生成脚本：服务于毕业论文材料，不属于 Xiezhi 工具本体。
# 注：generate_test_report_from_run.py 虽在 CI 白名单内，仍按本地脚本处理。
scripts/fill_project_forms_from_templates.py
scripts/generate_project_forms.py
scripts/generate_technical_function_doc.py
scripts/generate_thesis_docx.py
scripts/generate_software_test_doc.py
scripts/generate_test_report_from_run.py
scripts/update_strict_proposal.py
scripts/update_thesis_documents.py
scripts/apply_proposal_comments.py
**/.venv/

# Temporary dev servers and test helpers
security-toolbox-web/spa-server.cjs

# Ad-hoc browser test scripts superseded by security-toolbox-web/tests/e2e/.
# Kept locally for reference; not part of the published test suite.
security-toolbox-web/scripts/debug-scan.cjs
security-toolbox-web/scripts/e2e-full-chain.cjs
security-toolbox-web/scripts/ui-e2e-test.cjs
security-toolbox-web/scripts/ui-full-flow-test.cjs
security-toolbox-web/scripts/ui-scanner-test.cjs
security-toolbox-web/scripts/ui-target-verify.cjs

# 一次性的临时排查脚本（文件名以 tmp- 开头）。这类脚本只为定位某个具体问题
# 而写，用完即弃，不做回归用途，也不应进入公开仓库。约定以此前缀命名即自动
# 屏蔽，避免每次都要手动确认是否误提交。
security-toolbox-web/scripts/tmp-*.cjs
security-toolbox-web/scripts/tmp-*.mjs
security-toolbox-web/scripts/tmp-*.js

# End-to-end test evidence, artifacts and runtime credentials.
# Already covered by .run/, listed explicitly so they stay ignored
# even when a run writes outside that directory.
**/e2e-evidence/
**/e2e-artifacts/
**/e2e-credentials.json
**/test-report-artifact.html
**/test-report-section-*.md
**/test-data/
**/.toolbox-build-manifest.json

